# ==========================================
# DAFL E-COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# PostgreSQL Database (Lightweight Alpine)
POSTGRES_DB=dafl_db
POSTGRES_USER=dafl
POSTGRES_PASSWORD=dafl_password123
POSTGRES_PORT=5432

# Redis Cache (Disabled to save RAM)
CACHE_ENABLED=false

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# PayOS Payment Gateway Credentials (Replace with your actual keys from https://payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# Frontend Configuration
FRONTEND_PORT=3000
# Cổng trang quản trị riêng (service dafl-admin, build với VITE_ADMIN_ONLY=true)
ADMIN_PORT=3001
BACKEND_PORT=5000
# Cổng Gateway YARP (service dafl-gateway, đợt 14) — điểm vào chung shop + API
GATEWAY_PORT=8080

# JWT (CN-02) — secret ký JWT hạn 1 giờ cho đăng nhập/đăng ký/social.
# Đặt một chuỗi NGẪU NHIÊN, dài (≥ 32 ký tự), không chia sẻ, không commit lên git.
JWT_SECRET=<chuỗi bí mật ngẫu nhiên của bạn>

# Social login — Đăng nhập/Đăng ký bằng Google & Facebook (Luồng 6)
# Việc Daniel phải tự làm (Muse không tạo thay được):
#  1) Google: vào Google Cloud Console → tạo project → APIs & Services → Credentials →
#     Create OAuth client ID (Web application) → khai Authorized JavaScript origins: http://localhost:3000
#     → copy "Client ID" vào GOOGLE_CLIENT_ID (luồng id_token không cần Client Secret).
GOOGLE_CLIENT_ID=
#  2) Facebook: vào Meta for Developers → tạo app → thêm sản phẩm Facebook Login →
#     khai báo domain localhost → copy App ID và App Secret vào hai biến dưới đây.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMTP — Gửi email đặt lại mật khẩu thật (đợt 13, mục 1) + mail cảnh báo đổi mật khẩu admin.
# Bắt buộc đủ 4 giá trị Host/Username/Password/From thì backend mới gửi mail thật;
# để trống → quên mật khẩu chỉ ghi mã ra log ở Development (không gửi mail).
# Gợi ý Gmail: bật 2-Step Verification cho tài khoản Google rồi tạo App Password
# (Google Account → Security → App passwords, chọn "Mail") và điền vào SMTP_PASSWORD —
# KHÔNG dùng mật khẩu đăng nhập Gmail thường. SMTP_FROM nên trùng SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_ENABLE_SSL=true
